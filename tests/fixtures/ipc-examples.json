{
  "$comment": "Example IPC messages, one per array element, validated against schemas/ipc-message.json by tests/fixtures/validate.py (the REVIEW command). Keep in sync with docs/contracts/ipc.md §7.",
  "schema": "https://deckstack.dev/schemas/ipc-message.json/v1",
  "messages": [
    {"id": 0, "op": "hello", "protocol": 1, "client": "ds/0.1.0"},
    {"id": 1, "op": "auth", "token": "0123456789abcdef0123456789abcdef", "scope": "admin"},
    {"id": 2, "op": "ping"},
    {"id": 3, "op": "get", "path": "/meta"},
    {"id": 4, "op": "get", "path": "/controls/keys/0", "fields": ["image", "label"]},
    {"id": 5, "op": "set", "ops": [{"op": "set", "path": "/controls/keys/0/image", "value": {"kind": "color", "value": "#3cc86e"}}], "if_rev": 41},
    {"id": 6, "op": "set", "ops": [{"op": "delete", "path": "/controls/keys/0/label"}]},
    {"id": 7, "op": "subscribe", "path": "/controls/keys/*", "from_rev": 41},
    {"id": 8, "op": "unsubscribe", "path": "/controls/keys/*"},
    {"id": 9, "op": "emit", "topic": "app/demo/hello", "payload": {"n": 1}},
    {"id": 10, "op": "bind", "binding": {"id": "b0001", "topic": "deck/control/keys.0/down", "allow_exec": false, "when": {"payload": "control", "op": "exists"}, "steps": [{"do": "plugin", "id": "demo", "action": "bump", "args": {"by": 1}}]}},
    {"id": 11, "op": "unbind", "id": "b0001"},
    {"id": 12, "op": "plugin", "action": "list"},
    {"id": 13, "op": "plugin", "action": "invoke", "id": "demo", "args": {"action": "bump", "by": 2}},
    {"id": 14, "op": "stream-open", "target": "keys", "credits": 8},
    {"id": 15, "op": "stream-stats", "target": "keys"},
    {"id": 16, "op": "stream-stop", "target": "keys"},
    {"id": 17, "op": "daemon", "action": "status"},
    {"id": 18, "op": "token", "action": "issue", "scope": "read"},
    {"id": 19, "op": "schema", "name": "stream-frame"},
    {"id": 0, "ok": true, "result": {"op": "welcome", "protocol": 1, "rev": 1, "server": "ds-daemon/0.1.0"}},
    {"id": 1, "ok": true, "result": {"scope": "admin"}},
    {"id": 5, "ok": true, "rev": 42},
    {"id": 5, "ok": false, "error": {"code": "E_CONFLICT", "message": "rev is 42", "current_rev": 42}},
    {"id": 6, "ok": false, "error": {"code": "E_SCOPE", "message": "token scope 'read' cannot perform 'set'"}},
    {"id": 7, "ok": false, "error": {"code": "E_AUTH", "message": "bad token"}},
    {"op": "event", "path": "/controls/keys/0/image", "rev": 42, "value": {"kind": "color", "value": "#3cc86e"}},
    {"op": "event", "path": "/telemetry/streams/keys", "telemetry": true, "value": {"sent": 960, "dropped": 12, "fps": 32.0, "bytes": 6700000, "queue": 1, "in_flight": true, "last_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "last_seq": 959}},
    {"op": "dropped", "path": "/controls/keys/*", "count": 17},
    {"op": "stream-credit", "target": "keys", "credits": 8},
    {"op": "stream-ack", "target": "keys", "seq": 7},
    {"op": "stream-nack", "target": "keys", "seq": 8, "count": 1}
  ]
}
