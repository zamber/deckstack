{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckstack.dev/schemas/binding.json/v1",
  "title": "deckstack binding — an event topic mapped to steps",
  "description": "Stored in state at /bindings/<topic>. The core vocabulary is closed: set, emit, plugin, exec, sleep. No code fields exist — config is data (R8, ADR-007). See docs/contracts/actions.md.",
  "type": "object",
  "required": ["topic", "steps"],
  "additionalProperties": false,
  "properties": {
    "topic": {"type": "string", "pattern": "^(deck|app)/[A-Za-z0-9_./*-]{1,200}$"},
    "when": {
      "type": "object",
      "required": ["path", "op"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^/[A-Za-z0-9_./*-]{0,400}$"},
        "op": {"enum": ["exists", "eq", "neq", "gt", "lt"]},
        "value": {}
      }
    },
    "allow_exec": {
      "type": "boolean",
      "default": false,
      "description": "Must be true AND the caller's token scope must be admin AND /policy/exec/allow must list argv[0] for any exec step to run."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "step": {
      "oneOf": [
        {
          "type": "object",
          "required": ["do", "path", "value"],
          "additionalProperties": false,
          "properties": {
            "do": {"const": "set"},
            "path": {"type": "string", "pattern": "^/[A-Za-z0-9_./*-]{0,400}$"},
            "value": {"description": "Validated against schemas/state.json at the target path."}
          }
        },
        {
          "type": "object",
          "required": ["do", "topic"],
          "additionalProperties": false,
          "properties": {
            "do": {"const": "emit"},
            "topic": {"type": "string", "pattern": "^(deck|app)/"},
            "payload": {}
          }
        },
        {
          "type": "object",
          "required": ["do", "id", "action"],
          "additionalProperties": false,
          "properties": {
            "do": {"const": "plugin"},
            "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
            "action": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
            "args": {"description": "Validated against the plugin manifest action's JSON Schema params."}
          }
        },
        {
          "type": "object",
          "required": ["do", "argv"],
          "additionalProperties": false,
          "properties": {
            "do": {"const": "exec"},
            "argv": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {"type": "string", "maxLength": 4096},
              "description": "Executed directly via execve — NEVER through a shell. argv[0] must be absolute or resolvable via /settings/exec_path."
            },
            "cwd": {"type": "string", "pattern": "^(/tmp|/)"},
            "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000, "default": 10000}
          }
        },
        {
          "type": "object",
          "required": ["do", "ms"],
          "additionalProperties": false,
          "properties": {
            "do": {"const": "sleep"},
            "ms": {"type": "integer", "minimum": 1, "maximum": 60000}
          }
        }
      ]
    }
  }
}
