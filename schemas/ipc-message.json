{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckstack.dev/schemas/ipc-message.json/v1",
  "title": "deckstack daemon IPC messages (control plane, NDJSON)",
  "description": "One JSON object per line on the control socket/pipe. Requests and responses are discriminated by the 'ok' field on responses (m3): requests never have 'ok', responses always do. Binary DSF1 stream frames are NOT JSON and are described by schemas/stream-frame.json, referenced from docs/contracts/ipc.md §2. Which verb uses which transport is specified in docs/contracts/ipc.md §1.2. Example corpus: tests/fixtures/ipc-examples.json (validated by tests/fixtures/validate.py).",
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "id": {"type": "integer", "description": "Correlation id; present on all requests and on their responses, absent on async events."},
        "op": {"type": "string"}
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["E_AUTH", "E_SCOPE", "E_PATH", "E_SCHEMA", "E_CONFLICT", "E_LIMIT", "E_CAP", "E_UNREACHABLE", "E_DEVICE", "E_VERSION", "E_INTERNAL"], "description": "E_AUTH = bad/missing token. E_SCOPE (m4) = token valid but its scope is below the request's requirement. E_CAP = capability grant missing (plugins/exec/net/fs)."},
        "message": {"type": "string"},
        "path": {"type": "string"},
        "current_rev": {"type": "integer", "minimum": 0}
      }
    },
    "path": {"type": "string", "pattern": "^/[A-Za-z0-9_./*-]{0,400}$"},
    "opSet": {
      "type": "object",
      "properties": {
        "ops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["op", "path"],
            "properties": {
              "op": {"enum": ["set", "delete", "merge"]},
              "path": {"$ref": "#/$defs/path"},
              "value": {}
            }
          }
        },
        "if_rev": {"type": "integer", "minimum": 0}
      }
    }
  },
  "oneOf": [
    {"$comment": "=== requests (client -> daemon); none has 'ok' ===", "allOf": [{"$ref": "#/$defs/envelope"}], "not": {"required": ["ok"]}, "oneOf": [
      {"properties": {"op": {"const": "hello"}, "protocol": {"type": "integer", "minimum": 0, "description": "Wire protocol version. The server answers E_VERSION unless protocol == 1 (docs/contracts/ipc.md §2); the schema only bounds the type so a mismatched hello can be parsed and rejected with E_VERSION rather than E_SCHEMA."}, "client": {"type": "string"}}, "required": ["op", "protocol"]},
      {"properties": {"op": {"const": "auth"}, "token": {"type": "string", "minLength": 16}, "scope": {"enum": ["read", "mutate", "admin"]}}, "required": ["op", "token"]},
      {"properties": {"op": {"const": "ping"}}},
      {"properties": {"op": {"const": "get"}, "path": {"$ref": "#/$defs/path"}, "fields": {"type": "array", "items": {"type": "string"}}}, "required": ["op", "path"]},
      {"allOf": [{"$ref": "#/$defs/opSet"}], "properties": {"op": {"const": "set"}}, "required": ["op", "ops"]},
      {"properties": {"op": {"const": "subscribe"}, "path": {"$ref": "#/$defs/path"}, "from_rev": {"type": "integer", "minimum": 0}}, "required": ["op", "path"]},
      {"properties": {"op": {"const": "unsubscribe"}, "path": {"$ref": "#/$defs/path"}}, "required": ["op", "path"]},
      {"properties": {"op": {"const": "emit"}, "topic": {"type": "string", "pattern": "^(deck|app)/"}, "payload": {}}, "required": ["op", "topic"]},
      {"properties": {"op": {"const": "bind"}, "binding": {"$ref": "https://deckstack.dev/schemas/binding.json/v1"}}, "required": ["op", "binding"]},
      {"properties": {"op": {"const": "unbind"}, "binding": {"type": "string", "pattern": "^b[0-9]{4,}$", "description": "Binding id to remove. Named 'binding' (not 'id') because the envelope's 'id' is the integer correlation id; both must be able to coexist on one request."}, "topic": {"type": "string", "pattern": "^(deck|app)/", "description": "Alternative: remove by topic (ds unbind --topic)."}}, "required": ["op"], "anyOf": [{"required": ["binding"]}, {"required": ["topic"]}]},
      {"properties": {"op": {"const": "plugin"}, "action": {"enum": ["list", "invoke", "install", "remove"]}, "plugin": {"type": "string", "description": "Plugin id. Named 'plugin' (not 'id') because the envelope's 'id' is the integer correlation id; both must be able to coexist on one request."}, "args": {}}, "required": ["op", "action"]},
      {"properties": {"op": {"const": "stream-open"}, "target": {"type": "string", "pattern": "^(?:keys|dial|key:(?:[0-9]|1[0-4]))$"}, "credits": {"type": "integer", "minimum": 1, "maximum": 1024}}, "required": ["op", "target"], "description": "B1/S14: control-plane op that authorizes the client to push DSF1 binary frames for 'target' on the stream socket; the daemon replies with the credit budget. ds stream push = stream-open + binary frames, NOT an NDJSON op."},
      {"properties": {"op": {"const": "stream-stats"}, "target": {"type": "string", "pattern": "^(?:keys|dial|key:(?:[0-9]|1[0-4]))$"}}, "required": ["op", "target"], "description": "B1: reads /telemetry/streams/<target> (non-durable, no rev bump, S1)."},
      {"properties": {"op": {"const": "stream-stop"}, "target": {"type": "string", "pattern": "^(?:keys|dial|key:(?:[0-9]|1[0-4]))$"}}, "required": ["op", "target"], "description": "B1: drains and closes a stream target; waiting frame dropped, counted."},
      {"properties": {"op": {"const": "daemon"}, "action": {"enum": ["status", "stop", "reload"]}, "device": {"type": "string"}}, "required": ["op", "action"]},
      {"properties": {"op": {"const": "token"}, "action": {"enum": ["list", "issue", "revoke"]}, "scope": {"enum": ["read", "mutate", "admin"]}, "token_id": {"type": "string", "description": "Token id for 'revoke'. Named 'token_id' (not 'id') because the envelope's 'id' is the integer correlation id."}}, "required": ["op", "action"]},
      {"properties": {"op": {"const": "schema"}, "name": {"enum": ["state", "ipc", "stream-frame", "plugin-manifest", "binding"]}}, "required": ["op", "name"]}
    ]},
    {"$comment": "=== responses and async server messages (daemon -> client); all have 'ok' except events ===", "anyOf": [
      {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "id": {"type": "integer"},
          "ok": {"type": "boolean"},
          "rev": {"type": "integer", "minimum": 0},
          "result": {},
          "error": {"$ref": "#/$defs/error"}
        }
      },
      {
        "type": "object",
        "required": ["op"],
        "not": {"required": ["ok"]},
        "properties": {
          "op": {"enum": ["welcome", "event", "dropped", "stream-credit", "stream-ack", "stream-nack"]},
          "path": {"$ref": "#/$defs/path"},
          "value": {},
          "prev": {},
          "rev": {"type": "integer", "minimum": 0, "description": "Absent on /telemetry/* events (S1)."},
          "telemetry": {"const": true},
          "count": {"type": "integer", "minimum": 0},
          "target": {"type": "string"},
          "credits": {"type": "integer", "minimum": 0},
          "seq": {"type": "integer", "minimum": 0}
        }
      }
    ]}
  ]
}
