{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckstack.dev/schemas/ipc-message.json/v1",
  "title": "deckstack daemon IPC messages (control plane, NDJSON)",
  "description": "One JSON object per line. Client sends hello, auth, then requests with client-chosen integer id; daemon replies once per id. Stream-plane frames are binary (DSF1) and not covered here. See docs/contracts/ipc.md.",
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "id": {"type": "integer", "description": "Correlation id; present on all requests and responses except async events."},
        "op": {"type": "string"}
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["E_AUTH", "E_PATH", "E_SCHEMA", "E_CONFLICT", "E_LIMIT", "E_CAP", "E_UNREACHABLE", "E_DEVICE", "E_VERSION", "E_INTERNAL"]},
        "message": {"type": "string"},
        "path": {"type": "string"},
        "current_rev": {"type": "integer", "minimum": 0}
      }
    },
    "opSet": {
      "type": "object",
      "properties": {
        "ops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["op", "path"],
            "properties": {
              "op": {"enum": ["set", "delete", "merge"]},
              "path": {"type": "string", "pattern": "^/[A-Za-z0-9_./*-]{0,400}$"},
              "value": {}
            }
          }
        },
        "if_rev": {"type": "integer", "minimum": 0}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "hello"}, "protocol": {"const": 1}, "client": {"type": "string"}}, "required": ["op", "protocol"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "auth"}, "token": {"type": "string", "minLength": 16}, "scope": {"enum": ["read", "mutate", "admin"]}}, "required": ["op", "token"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "ping"}}},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "get"}, "path": {"type": "string"}, "fields": {"type": "array", "items": {"type": "string"}}}, "required": ["op", "path"]},
    {"$ref": "#/$defs/envelope", "allOf": [{"$ref": "#/$defs/opSet"}], "properties": {"op": {"const": "set"}}, "required": ["op", "ops"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "subscribe"}, "path": {"type": "string"}, "from_rev": {"type": "integer", "minimum": 0}}, "required": ["op", "path"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "unsubscribe"}}, "required": ["op", "path"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "emit"}, "topic": {"type": "string", "pattern": "^(deck|app)/"}, "payload": {}}, "required": ["op", "topic"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "bind"}, "topic": {"type": "string"}, "binding": {"$ref": "https://deckstack.dev/schemas/binding.json/v1"}}, "required": ["op", "topic", "binding"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "unbind"}, "topic": {"type": "string"}}, "required": ["op", "topic"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "plugin"}, "action": {"enum": ["list", "invoke", "install", "remove"]}, "id": {"type": "string"}, "args": {}}, "required": ["op", "action"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "stream-open"}, "target": {"type": "string"}}, "required": ["op", "target"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "daemon"}, "action": {"enum": ["status", "stop", "reload"]}}, "required": ["op", "action"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "token"}, "action": {"enum": ["list", "issue", "revoke"]}, "scope": {"enum": ["read", "mutate", "admin"]}, "id": {"type": "string"}}, "required": ["op", "action"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "schema"}, "name": {"enum": ["state", "ipc", "plugin-manifest", "binding"]}}, "required": ["op", "name"]},
    {"$ref": "#/$defs/envelope", "properties": {"op": {"const": "test"}, "what": {"const": "frame-sha"}, "path": {"type": "string"}}, "required": ["op", "what", "path"]},
    {
      "type": "object",
      "description": "Daemon -> client responses and async events.",
      "properties": {
        "id": {"type": "integer"},
        "ok": {"type": "boolean"},
        "rev": {"type": "integer", "minimum": 0},
        "result": {},
        "error": {"$ref": "#/$defs/error"},
        "op": {"enum": ["welcome", "event", "dropped", "stream-credit", "stream-ack", "stream-nack"]},
        "path": {"type": "string"},
        "value": {},
        "prev": {},
        "count": {"type": "integer", "minimum": 0},
        "target": {"type": "string"},
        "credits": {"type": "integer", "minimum": 0},
        "seq": {"type": "integer", "minimum": 0}
      },
      "required": ["ok"]
    }
  ]
}
