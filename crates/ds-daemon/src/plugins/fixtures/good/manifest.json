{
  "id": "tp1",
  "name": "Test plugin one",
  "version": "0.1.0",
  "description": "DS-050 in-crate test plugin (handshake, effects, caps, net, crash, probe).",
  "command": ["/usr/bin/python3", "plugin.py"],
  "capabilities": ["state.read", "state.write", "emit", "net:127.0.0.1"],
  "actions": [
    {"id": "bump", "name": "Bump the counter", "params": {"type": "object", "properties": {"by": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
    {"id": "violate", "params": {"type": "object"}},
    {"id": "sleep", "params": {"type": "object"}},
    {"id": "crash", "params": {"type": "object"}},
    {"id": "net", "params": {"type": "object", "properties": {"url": {"type": "string"}}, "required": ["url"]}},
    {"id": "probe", "params": {"type": "object", "properties": {"secret": {"type": "string"}, "port": {"type": "integer"}}}},
    {"id": "echo", "params": {"type": "object"}},
    {"id": "getstate", "params": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}
  ],
  "events": ["keyDown", "state"],
  "resources": {"cpu_s": 10, "nproc": 64, "nofile": 64, "as_mb": 1024},
  "fs_roots": []
}
